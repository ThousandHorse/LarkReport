# ===================================
# Google Tasks API 認証情報
# CLIENT_ID / CLIENT_SECRET: Google Cloud Console で取得する
# REFRESH_TOKEN: OAuth2 認証フロー（認可コードの交換）を実行して取得する
# ===================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# ===================================
# Gemini API キー
# https://aistudio.google.com/app/apikey で取得（無料枠あり）
# ===================================
GEMINI_API_KEY=your-gemini-api-key

# ===================================
# Slack Bot Token
# Slack App の「OAuth & Permissions」画面で取得する（xoxb- で始まる）
# 必要スコープ: files:write, chat:write
# ===================================
SLACK_BOT_TOKEN=your-slack-bot-token

# ===================================
# Slack 投稿先チャンネル ID
# チャンネル名ではなく ID（例: C0123456789）を使用する
# チャンネルを右クリック → 「チャンネル詳細を表示」→ 最下部に表示される
# ===================================
SLACK_CHANNEL_ID=your-slack-channel-id

# ===================================
# Zaim API 認証情報（Zeny 収支レポート用）
# Zaim Developer Console (https://dev.zaim.net) で取得する
# ===================================
ZAIM_CLIENT_ID=your-zaim-consumer-key
ZAIM_CLIENT_SECRET=your-zaim-consumer-secret
ZAIM_ACCESS_TOKEN=your-zaim-access-token
ZAIM_ACCESS_TOKEN_SECRET=your-zaim-access-token-secret

# ===================================
# Google Sheets（Zeny 収支手動入力・futureExpenses 用）
# ZENY_SPREADSHEET_ID: node apps/Zeny/src/googleSheets.js を初回実行して取得する
# GOOGLE_REFRESH_TOKEN は spreadsheets スコープを含む必要がある
#   → node apps/Zeny/src/refreshToken.js で再取得
# ===================================
ZENY_SPREADSHEET_ID=your-zeny-spreadsheet-id

# ===================================
# Slack Socket Mode（PR-17C〜 Zeny モーダル用）
# SLACK_APP_TOKEN: Slack App の「App-Level Tokens」で生成（xapp- で始まる）
# SLACK_SIGNING_SECRET: Slack App の「Basic Information」で確認
# ===================================
SLACK_APP_TOKEN=your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
