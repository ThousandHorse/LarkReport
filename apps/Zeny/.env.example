# Google OAuth2 認証情報
# ⚠️ GOOGLE_REFRESH_TOKEN は以下のスコープを含む必要がある（node apps/Zeny/src/refreshToken.js で取得）
#   - https://www.googleapis.com/auth/calendar.readonly
#   - https://www.googleapis.com/auth/spreadsheets
# CLIENT_ID / CLIENT_SECRET は Daily と同じ Google Cloud プロジェクトのものでOK
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gemini
GEMINI_API_KEY=

# Slack
SLACK_BOT_TOKEN=        # Daily と同じ Bot Token でOK（スコープ: files:write, chat:write）
SLACK_CHANNEL_ID=       # 送信先チャンネル ID
SLACK_SIGNING_SECRET=   # Slack モーダル用（PR-17）

# Zaim
ZAIM_CLIENT_ID=
ZAIM_CLIENT_SECRET=
ZAIM_ACCESS_TOKEN=
ZAIM_ACCESS_TOKEN_SECRET=

# Google Sheets（Zeny 収支手動入力・futureExpenses 用）
# initSpreadsheet() を初回実行して取得: node apps/Zeny/src/googleSheets.js
ZENY_SPREADSHEET_ID=

# Slack Socket Mode（PR-17C〜 Zeny モーダル用）
SLACK_APP_TOKEN=        # xapp- で始まる App-Level Token
SLACK_SIGNING_SECRET=   # Slack App の Basic Information で確認
