# Google OAuth2 認証情報
# ⚠️ Daily で使用している GOOGLE_REFRESH_TOKEN は tasks.readonly スコープのみのため流用不可
# Calendar API (events.list) を使用するため、以下のスコープで再取得が必要:
#   - https://www.googleapis.com/auth/calendar.readonly
# CLIENT_ID / CLIENT_SECRET は Daily と同じ Google Cloud プロジェクトのものでOK
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gemini
GEMINI_API_KEY=

# Slack
SLACK_BOT_TOKEN=        # Daily と同じ Bot Token でOK（スコープ: files:write, chat:write）
SLACK_CHANNEL_ID=       # 送信先チャンネル ID
SLACK_SIGNING_SECRET=   # Slack モーダル用（PR-17）

# Zaim
ZAIM_CLIENT_ID=
ZAIM_CLIENT_SECRET=
ZAIM_ACCESS_TOKEN=
ZAIM_ACCESS_TOKEN_SECRET=
